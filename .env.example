# Telegram bot token from @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Your Vercel deployment URL (set after first deploy)
WEBHOOK_URL=https://your-app.vercel.app

# Upstash Redis (free at upstash.com — needed for serverless state)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Google Gemini API key (free at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Notion integration token (internal integration)
NOTION_TOKEN=secret_your_notion_integration_token_here

# Optional: guards /cron/keepalive against public callers. If set, must also be
# added as CRON_SECRET in Vercel project env vars — Vercel sends it automatically
# as the Authorization header on Cron Job invocations.
CRON_SECRET=
